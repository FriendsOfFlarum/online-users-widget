{
    "name": "fof/online-users-widget",
    "description": "Forum Widget That Lists Online Users",
    "keywords": [
        "flarum", "widget", "online", "users"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://friendsofflarum.org",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/online-users-widget/issues",
        "source": "https://github.com/FriendsOfFlarum/online-users-widget",
        "forum": "https://discuss.flarum.org/"
    },
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "replace": {
        "afrux/online-users-widget": "*"
    },
    "require": {
        "php": "^8.2",
        "flarum/core": "^1.8.0",
        "fof/forum-widgets-core": "1.x-dev"
    },
    "require-dev": {
        "flarum/testing": "^1.0.0",
        "flarum/phpstan": "*"
    },
    "autoload": {
        "psr-4": {
            "FoF\\OnlineUsers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\OnlineUsers\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "flarum-extension": {
            "title": "FoF Online Users Widget",
            "category": "forum-widget",
            "icon": {
                "name": "fas fa-user-friends",
                "backgroundColor": "#e34b6e",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    }
}
